{
  "name": "motogear-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MotoGear e-commerce REST API (Express + MongoDB)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:admin": "node src/seed/createAdmin.js",
    "test": "node --test --test-concurrency=1 test/",
    "db:sync-indexes": "node src/seed/syncIndexes.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
