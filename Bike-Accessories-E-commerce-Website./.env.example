# Base URL of the backend API.
#   Docker / nginx proxy (recommended): /api
#   Separate API domain:                https://api.your-domain.com/api  (and add the site URL to the API's CLIENT_URL)
#   Local development:                  http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# true  -> built-in mock data (no backend needed; the admin panel is unavailable)
# false -> talk to the real backend (use this in production)
VITE_USE_MOCK=false
