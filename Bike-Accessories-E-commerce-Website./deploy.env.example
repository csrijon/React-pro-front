# Copy to deploy.env (never commit it) and fill in every value.
# Public address of the site, no trailing slash. Use https:// in production.
SITE_URL=https://www.your-domain.com
WEB_PORT=80
# Reverse proxies in front of the API: 1 = only the bundled nginx (exposed directly),
# 2 = a TLS proxy / CDN (Caddy, Cloudflare, load balancer) -> nginx -> API. Wrong values let clients fake their IP.
TRUST_PROXY=1
# Require two-factor authentication for admin accounts (strongly recommended - keep true)
REQUIRE_ADMIN_2FA=true

MONGO_USER=motogear
MONGO_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email (recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MotoGear <no-reply@your-domain.com>
ADMIN_NOTIFY_EMAIL=

# Razorpay (leave empty for Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
