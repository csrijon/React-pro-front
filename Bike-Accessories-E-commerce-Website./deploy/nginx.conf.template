server {
  listen 8080;
  server_name _;
  server_tokens off;                # do not advertise the nginx version
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 8m;          # image uploads from the admin panel

  gzip on;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # NOTE: nginx drops server-level add_header directives when a location sets its own,
  # so every location that adds headers includes the shared snippet explicitly.
  location = /healthz { access_log off; return 200 "ok\n"; }

  # ---- API + uploaded images are proxied to the Node service (same origin = no CORS) ----
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
  location /uploads/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    expires 30d;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
  }

  # ---- static assets: hashed filenames are cacheable forever ----
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # self-hosted hero/marketing images: versioned filenames (-v1) -> cache for a year
  location /img/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # Route-specific HTML variants (generated by scripts/postbuild.mjs) preload that route's JavaScript chunks,
  # removing a network round trip. Anything not listed falls through to index.html below.
  location = / { include /etc/nginx/snippets/html-headers.conf; try_files /home.html /index.html; }
  location = /shop { include /etc/nginx/snippets/html-headers.conf; try_files /shop.html /index.html; }
  location ^~ /category/ { include /etc/nginx/snippets/html-headers.conf; try_files /category.html /index.html; }
  location ^~ /product/ { include /etc/nginx/snippets/html-headers.conf; try_files /product.html /index.html; }
  location = /cart { include /etc/nginx/snippets/html-headers.conf; try_files /cart.html /index.html; }
  location = /login { include /etc/nginx/snippets/html-headers.conf; try_files /login.html /index.html; }
  location = /register { include /etc/nginx/snippets/html-headers.conf; try_files /register.html /index.html; }
  location = /about { include /etc/nginx/snippets/html-headers.conf; try_files /about.html /index.html; }
  location = /blog { include /etc/nginx/snippets/html-headers.conf; try_files /blog.html /index.html; }
  location = /brands { include /etc/nginx/snippets/html-headers.conf; try_files /brands.html /index.html; }
  location = /contact { include /etc/nginx/snippets/html-headers.conf; try_files /contact.html /index.html; }

  # self-hosted fonts: filenames carry a version (-v1), so they can be cached for a year
  location /fonts/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # ---- SPA fallback: every client-side route works on refresh ----
  location / {
    include /etc/nginx/snippets/html-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
