server {
  listen 8080;
  server_name _;
  server_tokens off;                # do not advertise the nginx version
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 8m;          # image uploads from the admin panel

  gzip on;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # NOTE: nginx drops server-level add_header directives when a location sets its own,
  # so every location that adds headers includes the shared snippet explicitly.
  location = /healthz { access_log off; return 200 "ok\n"; }

  # ---- API + uploaded images are proxied to the Node service (same origin = no CORS) ----
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
  location /uploads/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    expires 30d;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
  }

  # ---- static assets: hashed filenames are cacheable forever ----
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # self-hosted hero/marketing images: versioned filenames (-v1) -> cache for a year
  location /img/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # the home page gets an HTML variant that preloads the hero image (generated by scripts/postbuild.mjs)
  location = / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files /home.html /index.html;
  }

  # self-hosted fonts: filenames carry a version (-v1), so they can be cached for a year
  location /fonts/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # ---- SPA fallback: every client-side route works on refresh ----
  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
