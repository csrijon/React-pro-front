# Copy this file to .env and fill in real values. NEVER commit the real .env file.
# Backend runs on http://localhost:4000 by default.
PORT=4000

# Frontend origin allowed to call the API (Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Which LLM provider adapter to use: "mock" or "openai".
# "mock" = deterministic local demo answers (no API key needed, clearly flagged as demo).
# "openai" = any OpenAI-compatible /chat/completions endpoint (needs LLM_API_KEY).
LLM_PROVIDER=mock

# Provider settings (used when LLM_PROVIDER=openai)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=12000

# Optional: live weather for GET /api/weather (OpenWeatherMap). If empty -> demo data.
WEATHER_API_KEY=
WEATHER_PLACE=Barasat,West Bengal,IN
