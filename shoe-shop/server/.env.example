# Copy this file to server/.env (loaded automatically) or set these in the server's environment
# (for example the Render "Environment Variables" / Vercel / Railway / Fly.io dashboard).

NODE_ENV=development
PORT=4000

# REQUIRED: PostgreSQL connection string (Supabase, Neon, Render Postgres, Railway or local).
# Example local: postgres://user:password@localhost:5432/shoeshop
DATABASE_URL=postgresql://user:password@localhost:5432/shoeshop
# Set to true if your host requires TLS (Supabase, Neon, Render, Railway...).
# DATABASE_SSL=true

# REQUIRED in production: long random string used to sign login sessions.
JWT_SECRET=

# Used only to create the first admin when the database has no admin yet. REQUIRED in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: where uploaded images live (put on a persistent disk).
# UPLOAD_DIR=/var/data/uploads

# Image storage (Supabase Storage). When both are set, uploads go to the bucket instead of local disk.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Local disk uploads are only allowed outside production, or when explicitly enabled
# (self-hosting with a persistent UPLOAD_DIR).
# ALLOW_LOCAL_UPLOADS=false
