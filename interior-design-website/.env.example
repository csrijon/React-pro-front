# Frontend
# Base URL of the backend API. Leave empty to use browser-storage mock data.
VITE_API_URL=/api
VITE_USE_MOCK=false

# Backend (loaded by `npm run server`)
PORT=4000
# Local MongoDB, or an Atlas string like mongodb+srv://user:pass@cluster.mongodb.net/domus_studio
MONGODB_URI=mongodb://127.0.0.1:27017/domus_studio
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
